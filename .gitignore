# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
.venv/

# Node / frontend dependencies
node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.*
.okg/local.env
.okg/*.local.env
.okg/test-reports/
# Deployment controller receipts and backups are local runtime authority, not
# source. The planner validates their contents independently.
.okg/autoupdate/
.okg/up/
.okg/backups/
# closure intents queued while the decision ledger was unreachable
# (worktree-local runtime state; replayed by `okg pact evidence sync`)
.okg/pact-closure-intents/
.okg/pact-usage.jsonl
.okg/pact-authority-locks/
pact/changes/*/pact.yaml.lock
pact/archive/*/pact.yaml.lock
# pact.md is generated from pact.yaml by `gate post-edit` / `view --format=markdown`;
# render on demand instead of checking the artifact into git.
pact/changes/*/pact.md
pact/archive/*/pact.md

# Auth cookies
.cookies/

# OKG build artifacts and cached data
data/.pz/
testdata/
coverage.json
.coverage
# Per-process coverage data (pytest-cov with xdist writes .coverage.<host>.pid<N>.X<rand>
# until the session combines it). Untracked, it made the publisher's provenance
# check refuse publishes in the coverage legs (#3718).
.coverage.*

# Point-in-time run artifacts (perf reports, profiled-pact bundles, test
# result dumps) — regenerable; history retains them. Per PACT
# organize-repo-cleanup (task.gitignore-ephemera). Anchored at root so it
# doesn't swallow nested intentional dirs.
/reports/
/test-results/

# mutmut shadow tree (copy of src/ with mutated code; regenerable
# via `mutmut run`). Per `add-mutation-and-property-testing`.
mutants/

# Playwright run outputs.
tests/playwright/test-results/
tests/playwright/test-results.json
tests/playwright/html-report/
tests/playwright/playwright-report/

# Source-data caches and ingested snapshots — regenerable from external
# APIs, do NOT commit. Two oversized files (data/cms_snapshot.json at
# ~1.9 GB and data/cms/jira/records.json at ~174 MB) had to be removed
# from history with git-filter-repo on 2026-04-13 because they blew
# through GitHub's 100 MB blob limit. Don't put any deployment data
# under data/ in git.
data/cms/
data/cms_snapshot.json
data/audit/
data/*.json
data/*.md
data/*.log

# InterSystems deployment downloaded public data (large, reproducible)
deployments/intersystems/data/
deployments/intersystems/postgres/pgdata/

# Personal academic-researcher deployments scaffolded by the operator running
# `okg install --orcid <id>`. These hold a specific operator's
# install state (their ORCID, their picked ports, their MCP entry);
# not source-of-truth for the substrate. Per
# dogfood-academic-pi-deployment Stage 1.
deployments/dryrun_pi/
deployments/dogfood_test/
deployments/dogfood3/
deployments/dogfood4/

# OS
.DS_Store
Thumbs.db
data/memex/
data/af_pubs/
data/okg-self/

# uv's universal lock is committed as sealed-release dependency authority.
# Platform and Python-version alternatives are represented by lock markers.

# Scratch scripts for one-off Phase-0 style automation. Kept next to
# the work for review, never committed.
.scratch/

# Local formal-methods toolchain downloads. Bootstrap with
# `make formal-admission-bootstrap`; commit the script and checksum,
# not the jar.
.tools/

# TLC counter-example state dumps. Written into the working dir
# when an invariant is violated; ephemeral debugging artifacts.
states/
formal/**/states/

# Claude Code runtime state — worktrees (embedded git repos whose
# contents belong to their own branches, not this one) and
# per-session local settings.
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Commit-replay benchmark harness — generated artifacts.
# `bench/` itself (orchestrator, manifest, templates, plot code) IS
# committed; these subdirs are runtime output.
bench/deployments-generated/
bench/results/
bench/plots/

# Playwright + tooling runtime
.playwright-mcp/
.artifacts/
.tmp/

# Materializer output dirs (per-cycle manifests; regenerable from
# the substrate cycle that produced them)
deployments/*/views_out/

# Bootstrap staging dirs are generated from bootstrap_plan.yaml and
# verification state; commit the plan/evidence, not staged copies.
deployments/*/.okg_bootstrap/

# Profiling bundles (generated runtime artifacts; keep summaries in
# docs or commits, not the raw local captures). Anchor at root so
# this doesn't also swallow `src/okg/substrate/library/profiles/`,
# where the Layer 2A substrate-shipped deployment profiles live.
/profiles/

# Per-session memory files (operator's; not project state)
memories/

# Poros local demo artifacts include generated private keys.
.poros-demo/
.poros-nomos-demo/

# Nomos local demo artifacts are regenerated by `okg nomos demo`.
.nomos-demo/

# TLC model-checker state dumps are generated verification artifacts.
formal/**/states/

# Loose verification screenshots (recorded as evidence in RESULTS.md
# narratives, not as committed artifacts)
/*.png
/drawer-*.png
/view-*.png
/portal-*.png
tests/playwright/screenshots/

# Storybook static build output (regenerated by `npm run
# build-storybook`; commit the source stories, not the bundle).
**/storybook-static/

bench/per_source/deployments-generated/
bench/per_source/results/
bench/per_source/plots/

# PACT single-writer lock files — runtime flock handles held during a
# manifest mutation (pact/changes/<id>/pact.yaml.lock). Never committed.
pact/changes/**/*.lock
pact/.locks/
pact/.template-staging/

# okg-ci VM-local artifact stores: ci-results is a nested git checkout of the
# durable ci-results branch (populated by mirror_ci_results.py, ingested by the
# test-reports source); artifact_mirror is the retired manual mirror. Both are
# VM-local runtime state, never committed into the main repo.
deployments/okg-ci/ci-results/
deployments/okg-ci/artifact_mirror/

# Lean lake build artifacts (formal/consistency/lean)
.lake/

# Operator console redesign proof captures: regenerated by scripts/operator-ui-design/capture.mjs; capture.json carries their digests.
pact/changes/operator-ui-redesign-mocks/ui/rendered/
