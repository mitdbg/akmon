# Environment file for the AKMON runtime worker. Loaded by
# `okg-runtime-worker@.service` (systemd) via `EnvironmentFile=`.
#
# Copy to /etc/okg/runtime-worker.env and edit. Linux file mode
# should be 0600 — these values include database credentials.
#
#   sudo install -m 0600 -o okg -g okg \
#     docs/operate/deployments/assets/runtime-worker.env.example \
#     /etc/okg/runtime-worker.env
#
# Per-deployment overrides go in a drop-in:
#
#   sudo systemctl edit okg-runtime-worker@okg-workspace
#
# then in the editor:
#
#   [Service]
#   Environment="OKG_DSN=postgres://okg_substrate:…@db/okg_workspace"

# Postgres DSN interpolated into the deployment manifest's
# `postgres.dsn`. The worker connects under this role; the role must
# have the substrate permissions described in role_split.sql.
OKG_DSN=postgres://okg_substrate:CHANGE_ME@localhost:5433/okg

# Optional: override the manifest-declared deployment dir. Leave
# unset to use the discovered location.
# OKG_DEPLOYMENTS_ROOT=/var/lib/okg/deployments

# Optional: bind PYTHONPATH if the deployment dir is not next to the
# substrate checkout.
# PYTHONPATH=/opt/okg-deployments

# Optional logging tuning. Use `LOG_LEVEL=DEBUG` only when debugging;
# the worker logs are otherwise INFO-noisy enough to follow.
LOG_LEVEL=INFO
