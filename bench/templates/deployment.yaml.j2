# Generated by bench/orchestrator.py from bench/manifest.yaml.
# Do not edit by hand — regenerated on every `run` invocation.
#
# Experiment: {{ experiment_id }}
# Repo:       {{ repo_name }} ({{ repo_url }})
# Source set: {{ source_set }}

name: {{ experiment_id }}
description: |
  Commit-replay bench experiment for {{ repo_name }} under the
  {{ source_set }} source configuration. Generated from
  bench/manifest.yaml.

postgres:
  dsn: ${OKG_DSN}

# Bench deployments are generated outside the normal deployment-bootstrap
# path, so they must carry their privacy posture explicitly.  Without this
# block, strict at-rest posture resolution rejects every generated source and
# the replay harness waits for source-sync work that can never complete.
nomos:
  # Keep the performance harness's prior runtime mode: this benchmark isolates
  # source/publisher cost, not per-operation Nomos evaluation.  Source posture
  # is still synchronously audited and must explicitly authorize raw storage.
  runtime_enforcement: "off"
  deployment_posture:
    deployment_class: ci_authority
    read_principals:
      - ci_runner
      - okg_service
    write_principals:
      - ci_runner
      - okg_service
    mcp_write_default: deny
    export_policy: internal_only
    secret_handling: secret_ref_required
    live_call_default: review
    allowed_source_sensitivities:
      - internal
    allowed_data_classifications:
      - internal
    allowed_exportability:
      - internal
    privacy_obligations:
      - audit
    readiness_profiles:
      - ci
  source_policy_defaults:
    by_source_class:
      discovery_crawl:
        store_raw: true
        sensitivity: internal
        data_classification: internal
        credential_ref_policy: none
        live_call_allowed: false
        exportability: internal
        retention: source_defined
        provenance: local_filesystem
        privacy_obligations:
          - audit

runtime:
  enabled: true
  dbos_pool_size: 6
  okg_read_pool_size: 8
  okg_write_pool_size: 4
  concurrency:
    ingest.source_layer: 3
    gate.invariants: 1
    llm.telemetry: 2
  dbos_schema: dbos
  bypass_pgbouncer: false
  sdk_version: "1.0"
  workflows: []
  schedules:
    okg_publisher_cycle: "*/1 * * * *"
  source_sync:
    watch:
      enabled: true
      # Bench axis: too little debounce splits one `git reset --hard`
      # burst into multiple source-sync DBOS workflows; too much debounce
      # adds fixed latency. Keep this explicit so replay measurements show
      # the coalescing/latency tradeoff instead of hiding it in the template.
      debounce_seconds: {{ source_sync_watch_debounce_seconds }}
      # Git-ref changes are detected by the watcher HEAD poller. This is
      # independent from debounce: lowering it reduces commit detection
      # latency without splitting one reset burst into more batches.
      head_poll_interval_seconds: {{ source_sync_head_poll_interval_seconds }}
    poll:
      enabled: true
      slow_when_watch_active: true
      backstop_multiplier: 5
    webhook:
      enabled: false

chronos:
  # Commit replay creates many generation checkpoints in a short-lived bench
  # branch. Match dogfood's checkpoint-heavy setting so representative runs
  # do not exhaust interval space during restore/shutdown churn.
  # Swept axis (bench-okg-internals): config.chronos_continuation_pct.
  interval_continuation_percent: {{ chronos_continuation_pct }}
{% if native_view_min_refresh_interval_ms or native_view_materialization_delay_ms or attribute_effective_view_empty_overlay_fast_path %}

native_views:
{% if native_view_min_refresh_interval_ms %}
  # Explicit read-model freshness budget: commits may publish source graph
  # facts immediately while native view refresh is coalesced until this
  # interval expires, unless an operator forces a native-view refresh.
  min_refresh_interval_ms: {{ native_view_min_refresh_interval_ms }}
{% endif %}
{% if native_view_materialization_delay_ms %}
  # Bench replay often publishes multiple source layers for one commit. Delay
  # non-final native-view refreshes so those layers coalesce into the final
  # forced refresh instead of materializing the same views repeatedly.
  materialization_delay_ms: {{ native_view_materialization_delay_ms }}
{% endif %}
{% if attribute_effective_view_empty_overlay_fast_path %}
  # When no attribute overlays exist, effective attrs equal raw graph attrs.
  # Avoid copying every raw graph row into a generation-keyed read snapshot on
  # every tiny benchmark delta; operators retain the Layer-1 raw-graph fallback.
  attribute_effective_view_empty_overlay_fast_path: true
{% endif %}
{% endif %}
{% if include_code %}

consistency:
  # The `file_symbols` view cites `source_file` nodes; when a cited file is
  # deleted in a later commit its cite edge dangles until the view next
  # re-materializes. Match okg-workspace (the canonical views deployment):
  # prune dangling edges at publish rather than blocking. Narrowing violations
  # still block, so this does not loosen catalog integrity.
  dangling_edges: prune
{% endif %}

schema_dir: schemas
source_registry: source_registry.yaml

modules:
  - git_graph
{% if include_code %}
  # `code_graph` cross-references subtypes owned by other modules
  # (`tool_use_event` from agent_sessions, `open_spec_change` from
  # openspec, `test_case` from ci, etc.). Load the same superset
  # the okg-workspace deployment uses so catalog narrowings resolve.
  # Per-source rig (`add-per-source-sync-perf-harness`) hit the
  # same dependency cliff and resolved it the same way.
  - code_graph
  - openspec
  - agent_sessions
  - compute_env
  - extraction
  - forge
  - ci
  - quality_evidence
  - agent_memory
{% if include_views %}
  # Swept axis (bench-okg-internals): config.views. The `file_symbols`
  # operator view reads the code graph, so it only loads with code-bearing
  # source sets, and can be toggled off independently to isolate
  # view-materialization cost from ingest.
  - views
{% endif %}
{% elif include_doc_corpus %}
  # doc-corpus emits `document` / `document_chunk` nodes and
  # `derived_from` edges to git-files's `source_file` nodes.
  # The `extraction` ontology owns those subtypes + narrowings.
  - extraction
{% endif %}

{# Swept axis (bench-okg-internals): config.enrichers selects which enricher
   kinds load. `enricher_kinds` is the resolved list (e.g. ["declarative",
   "code_reference"]); empty -> no enrichers. This isolates per-enricher
   marginal cost instead of the old all-or-none include_enrichers flag. #}
{% if enricher_kinds %}
enrichers:
{%- if "declarative" in enricher_kinds %}
  # `DeclarativeLinker` — generic cross-source alias / mention
  # resolver driven by `entity_mention_resolves_via_alias_table`
  # and `okg_alias_fields` rules.  Two passes (the second one
  # forces a publish even when no nodes are dirty, so newly-seeded
  # aliases get a chance to fire).
  - class: okg.substrate.library.linkers.declarative.DeclarativeLinker
    config:
      name: declarative
      exclude_rule_ids:
        - entity_mention_resolves_via_alias_table
  - class: okg.substrate.library.linkers.declarative.DeclarativeLinker
    config:
      name: declarative_alias
      include_rule_ids:
        - entity_mention_resolves_via_alias_table
      publisher_skip_when_clean: false
{%- endif %}
{%- if "code_reference" in enricher_kinds %}
  # `CodeReferenceResolver` — resolves text mentions of code
  # symbols (in docs / commit messages / etc.) to code_symbol
  # nodes via the symbol's qualified name.
  - class: okg.substrate.library.linkers.code_reference.CodeReferenceResolver
{%- endif %}
{% else %}
enrichers: []
{% endif %}
{% if include_code and (include_code_lsp or (enricher_kinds and "code_reference" in enricher_kinds)) %}

# Several producers write the same `calls` / `references` edge identities;
# the graph stores the highest-ranked declarer's version, so an incremental
# replay and a forced rebuild store the same row (item 92a). Same ranking as
# okg-workspace: the code_reference enricher, then LSP, then code-structure.
edge_precedence:
{%- for edge_type in ["calls", "references"] %}
  {{ edge_type }}:
{%- if enricher_kinds and "code_reference" in enricher_kinds %}
    - _enricher:code_reference
{%- endif %}
{%- if include_code_lsp %}
    - code-lsp-resolution
{%- endif %}
    - code-structure
{%- endfor %}
{% endif %}

embeddings:
  # Swept axis (bench-okg-internals): config.embedding. Default off to isolate
  # the publisher path; flip on to measure embedding cost per commit.
  enabled: {{ 'true' if embedding_enabled else 'false' }}
  backend: hash
  reason: bench experiment; isolating publisher path
