# Generated by bench/orchestrator.py from bench/manifest.yaml.
# Do not edit by hand — regenerated on every `run` invocation.
#
# Experiment: {{ experiment_id }}
# Repo:       {{ repo_name }} ({{ repo_url }})
# Source set: {{ source_set }}

sources:

{% if include_files %}
  git-files:
    module: okg.substrate.library.sources.git_graph_files
    class: GitFilesSource
    ownership_id: {{ experiment_id }}.git-files
    params:
      repo: {{ repo_name }}
      repo_root: {{ repo_root }}
      include_untracked: false
      exclude_globs:
        - "**/__pycache__/**"
        - "**/.venv/**"
        - "**/*.pyc"

    source_class: discovery_crawl
    record_identity_kind: scoped_locator
    record_identity_fields: [repo, path]
    source_revision_kind: content_hash
    deletion_semantics: missing_from_completed_scope
    publication_mode: published_generation
    sync:
      watch:
        roots:
          - "{{ repo_root }}"
        # Match the production codebase-index config: watch working-tree
        # CONTENT only and exclude all of `.git/`. The previous config watched
        # `.git/HEAD`/`.git/refs` as fs_event content, so every `git reset`
        # fired a redundant `.git/HEAD`-scoped sync that did nothing but block
        # the (concurrency-1) source-sync queue behind the real file sync.
        # Prod never watches git internals as content; neither should the bench.
        include_globs:
          - "**/*"
        exclude_globs:
          - ".git/**"
          - "**/.git/**"
          - "**/__pycache__/**"
          - "**/*.pyc"
      # MANUAL-DRIVEN replay: the fs-event watcher is intentionally disabled
      # (no source declares fs_event/git_ref_change, so Watcher never starts).
      # commit_replay.py enqueues exactly ONE scoped source-sync per commit via
      # the `manual` trigger, so a single `git reset` can no longer fan out into
      # a racy burst of fs-event syncs that clog the concurrency-1 queue.
      triggers: [manual, reconcile]
      default_event_mode: scope_incomplete
      reconcile_mode: scope_complete
      deletes_require_reconcile: true
      scoped_delete_mode: scope_complete
      scoped_delete_dependent_fanout: direct
      cheap_probe: stat_tree
      scope:
        accepts: [path]
        unsupported_fallback: scope_complete
      dependents:
        on_event: direct
        on_reconcile: closure
      compaction:
        window_seconds: {{ source_sync_compaction_window_seconds }}
        max_events: 500
        max_scope_keys: 250
      poll:
        probe: change_probe
        interval_seconds: 60
{% endif %}

{% if include_history %}
  git-history:
    module: okg.substrate.library.sources.git_graph_history
    class: GitHistorySource
    ownership_id: {{ experiment_id }}.git-history
    params:
      repo: {{ repo_name }}
      repo_root: {{ repo_root }}
      include_remotes: false
{% if include_history_file_stubs %}
      source_file_stub_globs:
        - "*"
        - "**/*"
{% endif %}

    source_class: discovery_crawl
    record_identity_kind: scoped_locator
    record_identity_fields: [repo, commit_sha]
    source_revision_kind: content_hash
    deletion_semantics: missing_from_completed_scope
    publication_mode: published_generation
    sync:
      watch:
        roots:
          - "{{ repo_root }}"
        include_globs:
          - ".git/HEAD"
          - ".git/packed-refs"
          - ".git/refs/heads/**"
        exclude_globs:
          - "**/.git/objects/**"
          - "**/.git/logs/**"
          - "**/.git/lfs/**"
          - "**/.git/index"
          - "**/.git/index.lock"
          - "**/.git/COMMIT_EDITMSG"
          - "**/.git/ORIG_HEAD"
          - "**/.git/FETCH_HEAD"
          - "**/__pycache__/**"
          - "**/*.pyc"
      triggers: [git_ref_change, manual, reconcile]
      default_event_mode: {{ history_default_event_mode }}
      reconcile_mode: scope_complete
      deletes_require_reconcile: true
      cheap_probe: git_refs
      scope:
        accepts: [path]
        unsupported_fallback: scope_complete
      dependents:
        on_event: direct
        on_reconcile: closure
      compaction:
        window_seconds: {{ source_sync_compaction_window_seconds }}
        max_events: 500
        max_scope_keys: 250
      poll:
        probe: change_probe
        interval_seconds: 60
{% endif %}

{% if include_code %}
  code-structure:
    module: okg.substrate.library.sources.code_graph
    class: CodeStructureSource
    ownership_id: {{ experiment_id }}.code-structure
    predecessor_source: {{ experiment_id }}.git-files
    params:
      repo: {{ repo_name }}
      repo_root: {{ repo_root }}
      include_exts: [".py"]
      exclude_globs:
        - "**/__pycache__/**"
        - "**/.git/**"

    source_class: discovery_crawl
    record_identity_kind: scoped_locator
    record_identity_fields: [repo, node_id]
    source_revision_kind: content_hash
    deletion_semantics: missing_from_completed_scope
    publication_mode: published_generation
    sync:
      triggers: [manual, reconcile]
      default_event_mode: scope_complete
      reconcile_mode: scope_complete
      deletes_require_reconcile: true
      cheap_probe: stat_tree
      scope:
        accepts: [path]
        unsupported_fallback: scope_complete
      dependents:
        on_event: direct
        on_reconcile: closure
{% endif %}

{% if include_code_lsp %}
  code-lsp-resolution:
    module: okg.substrate.library.sources.code_graph
    class: CodeLspResolutionSource
    ownership_id: {{ experiment_id }}.code-lsp-resolution
    predecessor_source:
      - {{ experiment_id }}.git-files
      - {{ experiment_id }}.code-structure
    params:
      repo: {{ repo_name }}
      repo_root: {{ repo_root }}
      server_command:
        - "uv"
        - "run"
        - "--with"
        - "pyright==1.1.410"
        - "pyright-langserver"
        - "--stdio"
      server_name: pyright
      server_version: "1.1.410"
      language_id: python
      include_exts: [".py"]
      exclude_globs:
        - "**/__pycache__/**"
        - "**/.git/**"
        - "**/.venv/**"
        - "**/node_modules/**"
        - "**/*.pyc"
      max_files: 5000
      max_bytes_per_file: 1000000
      dependency_fanout_limit: 50
      reverse_dependency_fanout_limit: 50
      max_lsp_requests: 2000
      definition_request_concurrency: 16
      hot_path_max_lsp_requests: {{ lsp_hot_path_max_requests }}
      timeout_s: 5.0

    source_class: discovery_crawl
    record_identity_kind: scoped_locator
    record_identity_fields: [repo, path]
    source_revision_kind: content_hash
    deletion_semantics: missing_from_completed_scope
    publication_mode: published_generation
    admission_policy:
      producer_id: {{ experiment_id }}.code-lsp-resolution
      producer_kind: source
      trust_label: repo-local-trusted
      admission_mode: fast_track
      authority_scope:
        source_family: benchmark_repo
        path_globs:
          - "**/*.py"
      allowed_record_kinds:
        - edge
      output_signature:
        nodes: []
        edges:
          # code-lsp-resolution is a pure EDGE producer: both endpoints are
          # code_reference / code_symbol nodes owned by code-structure
          # (predecessor). Under chronos-native incremental admission an
          # endpoint created earlier in the same cycle can be unresolvable at
          # the moment the resolution edge is admitted, so BOTH endpoints opt
          # into optional discoverability. The narrowing trigger at projection
          # still enforces the catalog against the actual endpoint nodes.
          - src_subtype: code_reference
            edge_type: references
            dst_subtype: code_symbol
            src_subtype_optional: true
            dst_subtype_optional: true
            src_id_prefix: "reference:"
            dst_id_prefix: "symbol:{{ repo_name }}:"
            clause_id: {{ experiment_id }}.code_lsp_resolution.reference_references_symbol
          - src_subtype: code_symbol
            edge_type: calls
            dst_subtype: code_symbol
            src_subtype_optional: true
            dst_subtype_optional: true
            src_id_prefix: "symbol:{{ repo_name }}:"
            dst_id_prefix: "symbol:{{ repo_name }}:"
            clause_id: {{ experiment_id }}.code_lsp_resolution.symbol_calls_symbol
      policy_clauses:
        - id: {{ experiment_id }}.code_lsp_resolution.reference_references_symbol
          effect: allow
          record_kind: edge
          triple: [code_reference, references, code_symbol]
        - id: {{ experiment_id }}.code_lsp_resolution.symbol_calls_symbol
          effect: allow
          record_kind: edge
          triple: [code_symbol, calls, code_symbol]
      output_scope_summary:
        nodes: []
        edges:
          - code_reference references code_symbol
          - code_symbol calls code_symbol
        scope: "Benchmark LSP-backed semantic resolution edges for Python source"
    sync:
      triggers: [manual, reconcile]
      default_event_mode: scope_complete
      reconcile_mode: scope_complete
      deletes_require_reconcile: true
      scoped_delete_mode: scope_complete
      scoped_delete_dependent_fanout: none
      cheap_probe: stat_tree
      scope:
        accepts: [path]
        unsupported_fallback: scope_complete
      dependents:
        on_event: none
        on_reconcile: closure
{% endif %}

{% if include_package_manifests %}
  package-manifests:
