# Generated by bench/orchestrator.py for code-bearing source sets.
# Registers the non-LLM operator views materialized during the bench
# publish cycle. The deployment name must match the experiment id.
deployment: {{ experiment_id }}

views:
  - view_def_id: bench.file_symbols
    view_name: "File symbols (contains)"
    view_def_factory: views.file_symbols:file_symbols_view_def
    build_corpus: views.file_symbols:build_corpus
    anchor_resolver: views.file_symbols:anchor_resolver
    schedule: ""
    params: {}
    llm_client: stub
    # Rebuild when the files/symbols/containment this view reads change.
    reads_subtypes: [source_file, code_symbol]
    reads_edge_types: [contains]
  - view_def_id: bench.symbol_calls
    view_name: "Symbol calls (call graph)"
    view_def_factory: views.symbol_calls:symbol_calls_view_def
    build_corpus: views.symbol_calls:build_corpus
    anchor_resolver: views.symbol_calls:anchor_resolver
    schedule: ""
    params: {}
    llm_client: stub
    # The call graph is edge-derived: rebuild when code_symbol nodes or `calls`
    # edges change. Without this the view froze empty (its corpus was empty at
    # baseline so the node-keyed lineage index never invalidated it).
    reads_subtypes: [code_symbol]
    reads_edge_types: [calls]
