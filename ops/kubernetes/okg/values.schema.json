{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["okg", "images", "secrets", "extraEnv", "gitCredentials", "bootstrap", "postgresql", "runtime", "worker", "repositorySync", "mcp", "tests", "mirror"],
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "okg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment", "deploymentDsnEnv", "readinessProfile", "runtimeNomosSubject", "mcpNomosSubject", "repoRoot", "environmentDataRoot"],
      "properties": {
        "deployment": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "deploymentDsnEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "not": {
            "enum": [
              "OKG_DEPLOYMENT",
              "OKG_DSN_SOURCE",
              "OKG_MCP_RO_DSN",
              "OKG_DEPLOYMENTS_DIR",
              "OKG_REPO_ROOT",
              "OKG_ENVIRONMENT_DATA_ROOT",
              "OKG_RUNTIME_ENVIRONMENT",
              "OKG_NOMOS_SUBJECT",
              "GIT_PASSWORD",
              "GIT_AUTH_USERNAME",
              "GIT_REPOSITORY_URL",
              "GIT_REPOSITORY_REVISION",
              "MCP_ROLE_PASSWORD"
            ]
          }
        },
        "readinessProfile": {"type": "string", "enum": ["general", "dogfood", "ci", "standard"]},
        "runtimeNomosSubject": {"type": "string", "minLength": 1},
        "mcpNomosSubject": {"type": "string", "minLength": 1},
        "repoRoot": {"type": "string", "pattern": "^/"},
        "environmentDataRoot": {"type": "string", "pattern": "^/"}
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["okg", "pullSecrets"],
      "properties": {
        "okg": {"$ref": "#/$defs/okgImage"},
        "pullSecrets": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "postgresPasswordKey", "externalDsnKey", "mcpDsnKey", "mcpPasswordKey", "extraEnv"],
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1},
        "postgresPasswordKey": {"type": "string", "minLength": 1},
        "externalDsnKey": {"type": "string", "minLength": 1},
        "mcpDsnKey": {"type": "string", "minLength": 1},
        "mcpPasswordKey": {"type": "string", "minLength": 1},
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "key", "targets"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
              "key": {"type": "string", "minLength": 1},
              "targets": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "enum": ["bootstrap", "worker", "mirror"]}
              }
            }
          }
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "publishOnce", "include", "sourceWorkers", "requireApprovalRevision", "approvedRevision"],
      "properties": {
        "enabled": {"type": "boolean", "const": true},
        "publishOnce": {"type": "boolean"},
        "include": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "sourceWorkers": {"type": "integer", "minimum": 1, "maximum": 16},
        "requireApprovalRevision": {"type": "boolean"},
        "approvedRevision": {"type": "string"}
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internal", "image", "database", "port", "storage", "shmSizeLimit", "settings", "resources"],
      "allOf": [
        {
          "if": {
            "properties": {
              "internal": {
                "properties": {"enabled": {"const": true}},
                "required": ["enabled"]
              }
            },
            "required": ["internal"]
          },
          "then": {
            "properties": {
              "storage": {
                "properties": {
                  "storageClassName": {"minLength": 1}
                }
              }
            }
          }
        }
      ],
      "properties": {
        "internal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {"enabled": {"type": "boolean"}}
        },
        "image": {"$ref": "#/$defs/image"},
        "database": {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "storage": {"$ref": "#/$defs/postgresqlStorage"},
        "shmSizeLimit": {"type": "string", "minLength": 1},
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxConnections", "maxWorkerProcesses", "timescaledbMaxBackgroundWorkers", "maxLocksPerTransaction"],
          "properties": {
            "maxConnections": {"type": "integer", "minimum": 20},
            "maxWorkerProcesses": {"type": "integer", "minimum": 2},
            "timescaledbMaxBackgroundWorkers": {"type": "integer", "minimum": 0},
            "maxLocksPerTransaction": {"type": "integer", "minimum": 256}
          }
        },
        "resources": {"type": "object"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminationGracePeriodSeconds", "probes", "storage", "resources"],
      "properties": {
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 30},
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startup", "readiness"],
          "properties": {
            "startup": {"$ref": "#/$defs/execProbe"},
            "readiness": {"$ref": "#/$defs/execProbe"}
          }
        },
        "storage": {"$ref": "#/$defs/storage"},
        "resources": {"type": "object"}
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretMounts"],
      "properties": {
        "secretMounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "mountDir", "files"],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "mountDir": {
                "type": "string",
                "maxLength": 255,
                "pattern": "^/[A-Za-z0-9._/-]+$",
                "not": {"pattern": "(^|/)\\.\\.?(?:/|$)"}
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["secretKey", "fileName", "mode"],
                  "properties": {
                    "secretKey": {
                      "type": "string",
                      "maxLength": 253,
                      "pattern": "^[A-Za-z0-9._-]+$"
                    },
                    "fileName": {
                      "type": "string",
                      "maxLength": 255,
                      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$"
                    },
                    "mode": {"type": "string", "pattern": "^0[0-7]{3}$"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "targets"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "value": {"type": "string"},
          "targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "enum": ["bootstrap", "worker", "mcp", "mirror"]}
          }
        }
      }
    },
    "gitCredentials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts"],
      "properties": {
        "hosts": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "username", "secretKey"],
            "properties": {
              "host": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[0-9]{1,5})?$"},
              "username": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
              "secretKey": {"type": "string", "maxLength": 253, "pattern": "^[A-Za-z0-9._-]+$"}
            }
          }
        }
      }
    },
    "repositorySync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "url", "revision", "authSecretKey", "authUsername"],
      "properties": {
        "enabled": {"type": "boolean"},
        "url": {"type": "string"},
        "revision": {"type": "string"},
        "authSecretKey": {"type": "string"},
        "authUsername": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {
            "properties": {
              "url": {
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^https://[^@?#]+$"
              },
              "revision": {"minLength": 1}
            }
          }
        }
      ]
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "manageRole", "port", "allowedHosts", "resources"],
      "properties": {
        "enabled": {"type": "boolean", "const": true},
        "manageRole": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "allowedHosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 260,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::(?:\\*|[1-9][0-9]{0,4}))?$"
          }
        },
        "resources": {"type": "object"}
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotations", "readiness", "mcp"],
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resources"],
          "properties": {
            "resources": {"type": "object"}
          }
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resources"],
          "properties": {
            "resources": {"type": "object"}
          }
        }
      }
    },
    "mirror": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "command", "args", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "args": {"type": "array", "items": {"type": "string"}},
        "resources": {"type": "object"}
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {"create": {"type": "boolean"}, "name": {"type": "string"}}
    },
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean", "const": true}}
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": "integer", "const": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "postgresql": {
            "properties": {
              "internal": {
                "properties": {"enabled": {"const": true}}
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "mcp": {
            "properties": {"manageRole": {"const": true}}
          }
        }
      }
    }
  ],
  "$defs": {
    "execProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "periodSeconds": {"type": "integer", "minimum": 10},
        "timeoutSeconds": {"type": "integer", "minimum": 10},
        "failureThreshold": {"type": "integer", "minimum": 1}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      },
      "oneOf": [
        {
          "properties": {
            "tag": {"const": ""},
            "digest": {"const": ""}
          }
        },
        {
          "properties": {
            "tag": {"minLength": 1},
            "digest": {"const": ""}
          }
        },
        {
          "properties": {
            "tag": {"const": ""},
            "digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "okgImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      },
      "oneOf": [
        {
          "properties": {
            "tag": {"const": ""},
            "digest": {"const": ""}
          }
        },
        {
          "properties": {
            "tag": {"minLength": 1},
            "digest": {"const": ""}
          }
        },
        {
          "properties": {
            "tag": {"const": ""},
            "digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "storageClassName"],
      "properties": {
        "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"},
        "storageClassName": {"type": "string", "minLength": 1}
      }
    },
    "postgresqlStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "storageClassName"],
      "properties": {
        "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"},
        "storageClassName": {"type": "string"}
      }
    }
  }
}
