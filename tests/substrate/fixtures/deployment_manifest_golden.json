      "sdk_version": "1.0",
      "source_sync": {
        "poll": {
          "backstop_dependent_fanout": "none",
          "backstop_multiplier": 12,
          "enabled": true,
          "slow_when_watch_active": true
        },
        "watch": {
          "debounce_seconds": 5,
          "enabled": true
        },
        "webhook": {
          "enabled": false,
          "host": "127.0.0.1",
          "port": 8088
        }
      },
      "workflows": [
        "workflows.self_play",
        "workflows.resource_monitor",
        "workflows.history_compaction"
      ]
    },
