  "okg-workspace": {
    "agent_tools": {},
    "aliases": null,
    "audit_questions": null,
    "chronos": {
      "history_retention": {
        "audit_tail_generations": 50,
        "default": {
          "horizon": "14d"
        }
      },
      "interval_continuation_percent": 95
    },
    "description": "Workspace Graph deployment for the OKG repo",
    "embedding": {
      "enabled": false,
      "reason": "deterministic MCP traversal and lexical search are sufficient"
    },
    "enricher_registry": null,
    "link_config": null,
    "mcp_instructions": null,
    "mcp_pre_join_tools": null,
    "mcp_trace_path": null,
    "modules": [
      "person",
      "git_graph",
      "openspec",
      "agent_sessions",
      "compute_env",
      "code_graph",
      "extraction",
      "forge",
      "ci",
      "quality_evidence",
      "agent_memory",
      "reasoning",
      "coordination",
      "views",
      "chat_sessions",
      "scholarly",
      "dataset"
    ],
    "modules_config": {
      "agent_sessions": {
        "cwd_filter": [
          "<REPO_ROOT>"
        ],
        "since": "90d"
      },
      "code_graph": {
        "codeql_data_flow": {
          "artifact_globs": [],
          "artifact_paths": [
            "<REPO_ROOT>/deployments/okg-workspace/fixtures/data_flow/codeql.sarif"
          ],
          "max_artifacts": 100
        },
        "codex_archived_sessions_root": "~/.codex/archived_sessions",
        "codex_cwd_filter": [
          "<REPO_ROOT>"
        ],
        "codex_sessions_root": "~/.codex/sessions",
        "exclude_globs": [
          "__pycache__/**",
          "**/__pycache__/**",
          ".venv/**",
          "**/.venv/**",
          "node_modules/**",
          "**/node_modules/**",
          ".git/**",
          "**/.git/**",
          ".mypy_cache/**",
          "**/.mypy_cache/**",
          ".pytest_cache/**",
          "**/.pytest_cache/**",
          ".claude/**",
          "**/.claude/worktrees/**",
          "data/**",
          "testdata/**",
          "deployments/intersystems/**",
          ".scratch/**",
          ".tmp/**",
          ".artifacts/**",
          "memories/**",
          "**/*.pyc"
        ],
        "include_exts": [
          ".py",
          ".js",
          ".jsx",
          ".ts",
          ".tsx",
          ".go",
          ".rs",
          ".c",
          ".cc",
          ".cpp",
          ".cxx",
          ".h",
          ".hpp"
        ],
        "repo": "okg",
        "repo_root": "<REPO_ROOT>",
        "semgrep_data_flow": {
          "artifact_globs": [],
          "artifact_paths": [
            "<REPO_ROOT>/deployments/okg-workspace/fixtures/data_flow/semgrep.json"
          ],
          "max_artifacts": 100
        },
        "since": "90d"
      },
      "compute_env": {
        "cwd_filter": [
          "<REPO_ROOT>"
        ]
      },
      "git_graph": {
        "exclude_globs": [
          "**/__pycache__/**",
          "**/.venv/**",
          "**/node_modules/**",
          "**/.claude/worktrees/**",
          "data/**",
          "**/*.pyc"
        ],
        "include_history": true,
        "include_untracked": true,
        "repo": "okg",
        "repo_root": "<REPO_ROOT>"
      },
      "openspec": {
        "include_archived": true,
        "openspec_root": "<REPO_ROOT>/history/openspec",
        "repo": "okg"
      },
      "pact": {
        "pact_root": "<REPO_ROOT>/pact",
        "repo": "okg"
      }
    },
    "name": "okg-workspace",
    "postgres_dsn": null,
    "pre_join_resolvers": {},
    "profiling": null,
    "record_prefixes": [],
    "refreshers": null,
