{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okg.invalid/schemas/external-action-review/v1",
  "title": "OKG external action review trust configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "deployment", "authentication", "signing_keys"],
  "properties": {
    "schema": {"const": "okg.external_action_review.config/v1"},
    "deployment": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "route_alias": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "database_dsn": {"type": "string", "minLength": 1},
    "bind_host": {"type": "string", "minLength": 1, "maxLength": 253},
    "bind_port": {"type": "integer", "minimum": 0, "maximum": 65535},
    "action_registry_path": {"type": "string", "minLength": 1},
    "service_mode": {"enum": ["normal", "restore_only"]},
    "verifier_capability_env": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner_attestation_maximum_lifetime_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "deployment_product_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authored_definition_path", "product_plan_path", "expected_product_plan_digest"],
      "properties": {
        "authored_definition_path": {"type": "string", "minLength": 1},
        "product_plan_path": {"type": "string", "minLength": 1},
        "expected_product_plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_body_bytes_maximum": {"type": "integer", "minimum": 1, "maximum": 262144},
        "canonical_payload_bytes_maximum": {"type": "integer", "minimum": 1, "maximum": 131072},
        "json_nesting_depth_maximum": {"type": "integer", "minimum": 1, "maximum": 32},
        "total_object_members_maximum": {"type": "integer", "minimum": 1, "maximum": 512},
        "total_array_items_maximum": {"type": "integer", "minimum": 1, "maximum": 512},
        "total_scalar_values_maximum": {"type": "integer", "minimum": 1, "maximum": 4096},
        "individual_string_utf8_bytes_maximum": {"type": "integer", "minimum": 1, "maximum": 16384},
        "target_ref_utf8_bytes_maximum": {"type": "integer", "minimum": 1, "maximum": 256},
        "evidence_digest_count_maximum": {"type": "integer", "minimum": 1, "maximum": 64},
        "diff_field_code_count_maximum": {"type": "integer", "minimum": 1, "maximum": 128}
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "allowed_algorithms"],
      "properties": {
        "issuer": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1, "maxLength": 256},
        "allowed_algorithms": {"type": "array", "items": {"enum": ["EdDSA", "RS256", "ES256"]}, "minItems": 1, "uniqueItems": true},
        "max_token_lifetime_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "clock_skew_seconds": {"type": "integer", "minimum": 0, "maximum": 300},
        "jwks": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "trust_roots": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "trusted_proxy_names": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "static_bearer": {"type": "boolean"},
        "development_loopback_only": {"type": "boolean"}
      }
    },
    "signing_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kid", "purpose", "algorithm", "public_key_b64", "state"],
        "properties": {
          "kid": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+\\-]{0,255}$"},
          "purpose": {"type": "string", "enum": ["execution_epoch_lease", "claim_and_restore_completion", "ledger_fence", "worker_quiescence", "provider_authority_fence", "worker_checkpoint", "restore_attestation", "owner_unavailability_attestation"]},
          "algorithm": {"const": "EdDSA"},
          "public_key_b64": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
          "state": {"enum": ["current", "retired_for_signing_historically_valid", "revoked_compromised"]},
          "not_before": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
          "not_after": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
          "compromise_revoked_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"}
        }
      }
    }
  }
}
