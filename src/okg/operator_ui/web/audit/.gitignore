# Per-run audit output (live okg-workspace captures, Playwright artifacts, the
# rolled-up index, Gemini critiques). All regenerated by `npm run operator-ui:audit`.
reports/

# Visual-regression baselines (__screenshots__/) are NOT ignored: the committed
# deterministic-fixture screenshots are the gate contract -- audit/ci.sh compares
# against them, and the operator-ui-audit-linux CI lane regenerates + uploads them
# on the Linux runner (cross-platform AA means a dev-Mac baseline would not match).
# A NEW baseline (new view / viewport) must be committable without `git add -f`.

# Backgrounded dev-server PIDs + logs (start-servers.sh).
.servers/

# Stray Playwright output if run without the orchestrator's report dir.
.pw-report/
.pw-html/
.pw-artifacts/
test-results/
