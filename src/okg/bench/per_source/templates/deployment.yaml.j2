# Generated by bench/per_source/single_commit_breakdown.py.
# Watcher disabled — the rig drives the source by calling run_ingest()
# directly. Poll disabled for the same reason. This deployment is
# meant to register exactly one source.

name: {{ deployment }}
description: |
  Per-source perf rig. Source under test: {{ source_name }}.
  Generated against tinydb fixture at {{ repo_root }}.

postgres:
  dsn: ${OKG_DSN}

runtime:
  enabled: true
  dbos_pool_size: 6
  okg_read_pool_size: 8
  okg_write_pool_size: 4
  concurrency:
    ingest.source_layer: 3
    gate.invariants: 1
    llm.telemetry: 2
  dbos_schema: dbos
  bypass_pgbouncer: false
  sdk_version: "1.0"
  workflows: []
  schedules: {}
  source_sync:
    watch:
      enabled: false
    poll:
      enabled: false
    webhook:
      enabled: false

schema_dir: schemas
source_registry: source_registry.yaml

modules:
{% for m in modules %}  - {{ m }}
{% endfor %}

enrichers: []

embeddings:
  enabled: false
  reason: per-source perf rig; isolating source emission path
