sources:
  code-structure:
    module: okg.substrate.library.sources.code_graph
    class: CodeStructureSource
    ownership_id: {{ deployment }}.code-structure
    params:
      repo: tinydb
      repo_root: {{ repo_root }}
      include_exts: [".py"]
      exclude_globs:
        - "__pycache__/**"
        - "**/__pycache__/**"
        - ".git/**"
        - "**/.git/**"

    source_class: discovery_crawl
    record_identity_kind: scoped_locator
    record_identity_fields: [repo, node_id]
    source_revision_kind: content_hash
    deletion_semantics: missing_from_completed_scope
    publication_mode: published_generation
    sync:
      watch:
        roots: ["{{ repo_root }}"]
        include_globs: ["**/*.py"]
        exclude_globs: ["**/.git/**", "**/__pycache__/**"]
      triggers: [fs_event, manual, reconcile]
      default_event_mode: scope_complete
      reconcile_mode: scope_complete
      deletes_require_reconcile: true
      cheap_probe: stat_tree
      scope:
        accepts: [path]
        unsupported_fallback: scope_complete
      dependents:
        on_event: direct
        on_reconcile: closure
